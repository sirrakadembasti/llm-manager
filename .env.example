# Örnek sunucu (npm start) için zorunlu
LLM_ADMIN_USER=admin
LLM_ADMIN_PASSWORD=
# İsteğe bağlı
# Entegrasyon: basic ayrı LLM girişi; host yalnız Express yönetici oturumu adaptörüyle.
# LLM_AUTH_MODE=basic
# LLM_PAGE_PATH=/llm           # init çakışmada /llm1, /llm2 seçer
# LLM_API_PATH=/api/llm
# LLM_HOST_AUTH_MODULE=./llm-auth.cjs
# LLM_ADMIN_ROLES=admin
# LLM_PROJECT_ROOT=.          # hedef kaynak kökü; Express helper klasörüne göre çözülür
# LLM_OPENCODE_PATH=opencode
# LLM_GRAPHIFY_PYTHON=C:/path/to/graphify-environment/python.exe
# PORT=8010
# LLM_CONFIG_PATH=data/llm-profiles.json
# LLM_CONFIG_KEY_PATH=data/llm-encryption.key
# LLM_CONFIG_ENCRYPTION_KEY=   # 32 bayt hex/base64; boşsa otomatik üretilir
# LLM_ALLOW_LOCAL_HTTP=true    # yalnız yerel geliştirme
# LLM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:3000  # SPA / masaüstü CORS beyaz listesi
