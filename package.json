{
  "name": "llm-manager",
  "version": "1.0.0",
  "description": "Reusable authenticated LLM profile management and diagnostics",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "llm-manager": "bin/llm-manager.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./server": "./src/server.js",
    "./init": "./src/init.js",
    "./setup": "./src/setup.js",
    "./transport": "./src/providerTransport.js",
    "./runtime": "./src/runtime.js",
    "./errors": "./src/errors.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "start": "node examples/server.js",
    "release:patch": "npm test && npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm test && npm version minor -m \"chore(release): %s\"",
    "release:major": "npm test && npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "undici": "^7.30.0"
  },
  "peerDependencies": {
    "express": "^4.19.2 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirrakadembasti/llm-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sirrakadembasti/llm-manager/issues"
  },
  "homepage": "https://github.com/sirrakadembasti/llm-manager#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "express": "^4.19.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
