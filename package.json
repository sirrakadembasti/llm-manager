{
  "name": "@sirrakadembasti/llm-manager",
  "version": "2.0.0",
  "description": "Authenticated LLM profiles, persistent chats and reviewed project development",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "llm-manager": "bin/llm-manager.js"
  },
  "exports": {
    "./integration": {
      "types": "./types/integration.d.ts",
      "default": "./src/integration.js"
    },
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./src/server.js"
    },
    "./init": {
      "types": "./types/init.d.ts",
      "default": "./src/init.js"
    },
    "./setup": {
      "types": "./types/setup.d.ts",
      "default": "./src/setup.js"
    },
    "./transport": {
      "types": "./types/transport.d.ts",
      "default": "./src/providerTransport.js"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./errors": {
      "types": "./types/errors.d.ts",
      "default": "./src/errors.js"
    }
  },
  "files": [
    "bin",
    "src",
    "public",
    "types",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=80 --test-coverage-branches=70 tests/*.test.js tests/**/*.test.js",
    "typecheck": "tsc -p types/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "start": "node examples/server.js",
    "release:patch": "npm test && npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm test && npm version minor -m \"chore(release): %s\"",
    "release:major": "npm test && npm version major -m \"chore(release): %s\""
  },
  "dependencies": {
    "undici": "^8.12.4"
  },
  "peerDependencies": {
    "express": "^4.19.2 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Sirrakadembasti",
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "express",
    "proxy",
    "middleware",
    "chat",
    "streaming",
    "sse",
    "key-management"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirrakadembasti/llm-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sirrakadembasti/llm-manager/issues"
  },
  "homepage": "https://github.com/sirrakadembasti/llm-manager#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "express": "^4.19.2",
    "express5": "npm:express@^5.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
